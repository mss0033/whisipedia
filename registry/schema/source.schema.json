{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whisipedia.invalid/schema/source.schema.json",
  "title": "Whisipedia source registry",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "domain", "tier", "status", "license", "legal_basis"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string"},
        "publisher": {"type": "string"},
        "domain": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "tier": {"enum": ["T1", "T2", "T3", "X"]},
        "status": {"enum": ["candidate", "active", "paused", "retired", "excluded"]},
        "license": {"type": "string"},
        "legal_basis": {"enum": ["public-domain", "open-license", "bulk-access-terms", "permission-granted", "none"]},
        "languages": {"type": "array", "items": {"type": "string"}},
        "access": {"type": "object", "properties": {"adapter": {"type": "string"}}},
        "update": {
          "type": "object",
          "properties": {
            "cadence": {"type": "string", "description": "ISO 8601 duration"},
            "strategy": {"enum": ["snapshot-retention", "base-plus-incremental", "mirror"]},
            "settling_window": {"type": "string"}
          }
        },
        "size": {"type": "object", "properties": {"measured": {"type": "boolean"}, "as_of": {"type": "string", "format": "date"}}},
        "retention": {"type": "object"},
        "irreplaceable": {"type": "boolean"},
        "scores": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 5}},
        "notes": {"type": "string"},
        "index": {"type": "boolean", "description": "Refine and index for search (default true); false for sources served as stored or not text."},
        "rank_prior": {"type": "number", "minimum": 0, "description": "Constant ranking bonus for this source's matches; overrides [index.domain_priors] for its first domain (0: none)."}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "active"}}},
          "then": {"properties": {"legal_basis": {"not": {"const": "none"}}, "tier": {"not": {"const": "X"}}}}
        },
        {
          "if": {"required": ["access"], "properties": {"access": {"required": ["adapter"], "properties": {"adapter": {"const": "doc-collection"}}}}},
          "then": {"properties": {"access": {"$ref": "#/$defs/docCollectionAccess"}}}
        }
      ]
    },
    "docCollectionAccess": {
      "description": "access block of a doc-collection source (wsp_adapters.doccollection); a misspelled key would be ignored, so unknown keys are refused.",
      "type": "object",
      "required": ["adapter", "discovery"],
      "additionalProperties": false,
      "properties": {
        "adapter": {"const": "doc-collection"},
        "issuer": {"type": "string"},
        "key_prefix": {"type": "string"},
        "origins": {"type": "array", "items": {"type": "string"}},
        "discovery": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"enum": ["index-page", "api", "oai-pmh", "archive-org", "s3-listing", "git", "list", "document", "latest-dated"]}}
          }
        },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rules": {"type": "string"},
            "allow_series": {}, "allow_series_prefix": {}, "deny_series": {}, "deny_series_prefix": {},
            "deny_keywords": {}, "review_keywords": {}, "neutral_phrases": {},
            "allow_documents": {}, "deny_documents": {}, "allow_content_review": {}, "override_safety": {"type": "object"},
            "allow_all": {"type": "boolean"}, "default": {"enum": ["allow", "deny", "review"]},
            "declassified_ok": {"type": "boolean"}, "public_issuer": {"type": "boolean"}, "builtin_review": {"type": "boolean"}, "allow_image_only": {"type": "boolean"},
            "distribution": {"type": "object", "additionalProperties": false, "properties": {"require": {"type": "array", "items": {"type": "string"}}}}
          }
        },
        "formats": {"type": "array", "items": {"type": "string"}, "description": "file extensions the source takes (e.g. [pdf]); others are not fetched and leave the index"},
        "currency": {},
        "rate": {"type": "object"},
        "partitioned": {"type": "boolean"},
        "pdf_max_pages": {"type": "integer", "minimum": 1},
        "keep_superseded": {"type": "boolean"},
        "mirrors": {"type": "array"},
        "mirrors_required": {},
        "endpoints": {"type": "array"},
        "oai_endpoint": {"type": "string"},
        "decode_url_keys": {"type": "boolean", "description": "decode %XX escapes before a URL becomes a document key; changes keys, so only for sources with no stored documents"},
        "reader": {"enum": ["tei-frus", "tei-cts"], "description": "how a doc-collection's repository snapshot (git discovery with snapshot: true) becomes documents (wsp_adapters.doccollection.tei)"}
      }
    }
  }
}
