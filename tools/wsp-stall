def remaining() -> float:
    return DEADLINE - time.monotonic()


@dataclass
class State:
    """What one run leaves the next (``<state>/watch/state.json``)."""

    open: dict[str, tuple[float, str]] = field(
        default_factory=dict[str, tuple[float, str]]
    )  # key -> since, msg
    held: dict[str, float] = field(default_factory=dict[str, float])  # "lock:pid" -> first seen held
    cpu: dict[str, list[tuple[float, int]]] = field(default_factory=dict[str, list[tuple[float, int]]])
    offsets: dict[str, int] = field(default_factory=dict[str, int])  # log -> bytes read
    noted: dict[str, float] = field(default_factory=dict[str, float])  # problem kind -> when noted
    down: dict[str, float] = field(default_factory=dict[str, float])  # jobs.conf name -> first seen down
    runs: dict[str, str] = field(default_factory=dict[str, str])  # job unit -> InvocationID of its samples
    inactive: dict[str, float] = field(default_factory=dict[str, float])  # RUNNING unit -> first seen down
    saved: dict[str, str] = field(default_factory=dict[str, str])  # unit-failed key -> its saved journal
    pushed: dict[str, float] = field(default_factory=dict[str, float])  # key raised as a watch: alert
    waited: dict[str, float] = field(default_factory=dict[str, float])  # job unit -> last seen waiting

    @classmethod
    def load(cls, path: Path) -> State:
        try:
            raw = cast(dict[str, Any], json.loads(path.read_text()))
            return cls(
                open={k: (float(v[0]), str(v[1])) for k, v in raw.get("open", {}).items()},
                held={k: float(v) for k, v in raw.get("held", {}).items()},
                cpu={k: [(float(a), int(b)) for a, b in v] for k, v in raw.get("cpu", {}).items()},
                offsets={k: int(v) for k, v in raw.get("offsets", {}).items()},
                noted={k: float(v) for k, v in raw.get("noted", {}).items()},
                down={k: float(v) for k, v in raw.get("down", {}).items()},
                runs={k: str(v) for k, v in raw.get("runs", {}).items()},
                inactive={k: float(v) for k, v in raw.get("inactive", {}).items()},
                saved={k: str(v) for k, v in raw.get("saved", {}).items()},
                pushed={k: float(v) for k, v in raw.get("pushed", {}).items()},
                waited={k: float(v) for k, v in raw.get("waited", {}).items()},
            )
        except (OSError, ValueError, TypeError, AttributeError, IndexError):
            return cls()

    def save(self, path: Path) -> None:
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(asdict(self)))
        tmp.replace(path)


def now() -> float:
    return float(os.environ.get("WSP_STALL_NOW") or time.time())


def stamp(t: float) -> str:
    return datetime.fromtimestamp(t, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def hours(seconds: float) -> str:
    return f"{seconds / 3600:.1f} h"


def systemctl(*args: str) -> str | None:
    """Its output; ``None`` when it did not answer within SYSTEMCTL_S or the run's budget (unknown)."""
    exe = shutil.which("systemctl")
    if exe is None:
        return ""
    wait = min(SYSTEMCTL_S, remaining())
    if wait < 1:
        slow.append(" ".join(args[:2]) + " (the run's budget is spent)")
        return None
    try:
        done = subprocess.run(  # noqa: S603 - fixed argv
            [exe, "--user", *args], capture_output=True, text=True, check=False, timeout=wait
        )
    except subprocess.TimeoutExpired:  # systemd slow under memory pressure: unknown, not a crash
        slow.append(f"{' '.join(args[:2])} ({wait:.0f} s)")
        return None
    return done.stdout


def units() -> list[tuple[str, str, str]] | None:
    """``(unit, active, sub)`` of every whisipedia unit systemd knows (``None``: unknown)."""
    out = systemctl("list-units", "--all", "--no-legend", "--plain", "whisipedia-*")
    if out is None:
        return None
    rows: list[tuple[str, str, str]] = []
    for line in out.splitlines():
        f = line.split()
        if len(f) >= 4:
            rows.append((f[0], f[2], f[3]))
    return rows


def unit_prop(unit: str, prop: str) -> str | None:
    out = systemctl("show", unit, "-p", prop, "--value")
    return None if out is None else out.strip()


def cpu_usec(cgroup: str) -> int | None:
    try:
        for line in Path(f"{CGROUP_ROOT}{cgroup}/cpu.stat").read_text().splitlines():
            k, _, v = line.partition(" ")
            if k == "usage_usec":
                return int(v)
    except (OSError, ValueError):
        return None
    return None


def memory_stall(cgroup: str) -> tuple[float, str] | None:
    """The share (%) of the last 5 minutes the cgroup's tasks were all stalled on memory, and its
    memory use against its ceiling; ``None`` when unknown."""
    base = Path(f"{CGROUP_ROOT}{cgroup}")
    try:
        full = next(ln for ln in (base / "memory.pressure").read_text().splitlines() if ln.startswith("full"))
        pct = float(dict(f.split("=", 1) for f in full.split()[1:])["avg300"])
    except (OSError, StopIteration, KeyError, ValueError):
        return None
    try:
        use = f"{int((base / 'memory.current').read_text()) / 2**20:,.0f} MB"
        high = (base / "memory.high").read_text().strip()
        use += f" of memory.high {int(high) / 2**20:,.0f} MB" if high.isdigit() else ""
    except (OSError, ValueError):
        use = "use unknown"
    return pct, use


def frozen(cgroup: str) -> bool:
    """Whether the job's cgroup or a slice above it is frozen (tools/wsp-yield)."""
    parts = cgroup.strip("/").split("/")
    for i in range(len(parts), 0, -1):
        try:
            if Path(f"{CGROUP_ROOT}/{'/'.join(parts[:i])}/cgroup.freeze").read_text().strip() == "1":
                return True
        except OSError:
            continue
    return False


def process(pid: str) -> tuple[str, float | None]:
    """A process's command line and its age in seconds (None if it is gone)."""
    try:
        cmd = (PROC / pid / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
        start_ticks = int((PROC / pid / "stat").read_text().rsplit(")", 1)[1].split()[19])
        uptime = float((PROC / "uptime").read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return "", None
    return cmd, uptime - start_ticks / os.sysconf("SC_CLK_TCK")


def lock_waiters() -> dict[str, str]:
    """``pid -> lock name`` of every process blocked waiting for a lock file in LOCKS (``->`` lines);
    a lane's source lock in LANE_LOCKS is named ``lane:<source>``."""
    by_inode = {**_lock_inodes(LANE_LOCKS, "lane:"), **_lock_inodes()}
    out: dict[str, str] = {}
    try:
        lines = (PROC / "locks").read_text().splitlines()
    except OSError:
        return out
    for line in lines:
        f = line.split()
        if len(f) < 7 or f[1] != "->" or f[2] != "FLOCK":
            continue
        try:
            name = by_inode.get(_lock_file_key(f[6]))
        except (IndexError, ValueError):
            continue
        if name is not None:
            out[f[5]] = name
    return out


def queued(now: float) -> dict[str, tuple[str, int, float]]:
    """``pid -> (lock name, place in its queue from 1, seconds waited)`` of every waiter holding a ticket
    (``<lock>.queue/<time_ns>-<pid>``) whose process is alive."""
    out: dict[str, tuple[str, int, float]] = {}
    for q in sorted(LOCKS.glob("*.queue")):
        try:
            names = sorted(n.name for n in q.iterdir() if not n.name.startswith("."))
        except OSError:
            continue
        place = 0
        for name in names:
            stamp, _, pid = name.partition("-")
            if not (stamp.isdigit() and pid.isdigit() and (PROC / pid).is_dir()):
                continue
            place += 1
            try:  # its age is its mtime: the name is a steady-clock stamp (order only)
                waited = max(0.0, now - (q / name).stat().st_mtime)
            except OSError:
                continue
            out[pid] = (q.name.removesuffix(".queue"), place, waited)
    return out


def _lock_inodes(folder: Path = LOCKS, prefix: str = "") -> dict[str, str]:
    """``"MAJ:MIN:INODE" -> lock name`` as /proc/locks names files: the device too, since a file on the
    NAS can have the same inode number as a local lock file (2026-10-26 review)."""
    by_inode: dict[str, str] = {}
    for p in folder.glob("*.lock"):
        try:
            st = p.stat()
        except OSError:
            continue
        by_inode[f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"] = prefix + p.stem
    return by_inode


def _lock_file_key(field: str) -> str:
    """/proc/locks' ``MAJ:MIN:INODE`` (major and minor in hex), normalised to two hex digits each."""
    major, minor, inode = field.split(":")
    return f"{int(major, 16):02x}:{int(minor, 16):02x}:{int(inode)}"


def cgroup_pids(cgroup: str) -> set[str]:
    try:
        return set(Path(f"{CGROUP_ROOT}{cgroup}/cgroup.procs").read_text().split())
    except OSError:
        return set()


# A job between rounds: every process in it is a shell or its `sleep` (tools/lanes/lane-run.sh's
# pause, a job script's `sleep 7200` between passes). Idle by design, not stalled: 27 "job-idle" alerts
# in 10 days, most of them lanes waiting an hour for their next round (2026-10-29 spot check).
PAUSE_COMMS = frozenset({"sh", "bash", "dash", "sleep", "timeout"})


def pausing(pids: set[str]) -> bool:
    comms: set[str] = set()
    for pid in pids:
        try:
            # A script run by its shebang is named after the script (`lane-run.sh`): its executable,
            # the shell, says what it is (2026-10-30: the first such alert after the rule).
            try:
                name = os.path.basename(os.readlink(PROC / pid / "exe"))
            except OSError:
                name = (PROC / pid / "comm").read_text().strip()
        except OSError:
            return False  # gone, or unreadable: not known to be a pause
        comms.add("sh" if name.endswith(".sh") else name)
    return bool(comms) and comms <= PAUSE_COMMS and "sleep" in comms


def lock_holders() -> dict[str, tuple[str, str, float]]:
    """``lock name -> (pid, command, age seconds)`` of every lock file in LOCKS that is held."""
    by_inode = _lock_inodes()
    held: dict[str, tuple[str, str, float]] = {}
    try:
        lines = (PROC / "locks").read_text().splitlines()
    except OSError:
        return held
    for line in lines:
        f = line.split()
        if len(f) < 6 or f[1] != "FLOCK" or f[3] == "->":
            continue
        try:
            name = by_inode.get(_lock_file_key(f[5]))
        except ValueError:
            continue
        if name is None:
            continue
        cmd, age = process(f[4])
        if age is not None and (name not in held or age > held[name][2]):
            held[name] = (f[4], cmd, age)
    return held


def open_files(pid: str) -> tuple[int, int] | None:
    """``(open, soft limit)`` of a process's file descriptors."""
    try:
        count = len(list((PROC / pid / "fd").iterdir()))
        for line in (PROC / pid / "limits").read_text().splitlines():
            if line.startswith("Max open files"):
                return count, int(line.split()[3])
    except (OSError, ValueError, IndexError):
        return None
    return None


def health_ok() -> bool | None:
    """Whether the API answered 200 (``None``: the run's budget left no time to ask)."""
    for _ in range(2):
        wait = min(30.0, remaining())
        if wait < 1:
            return None
        try:
            with urllib.request.urlopen(HEALTH_URL, timeout=wait) as r:  # noqa: S310 - local API
                if r.status == 200:
                    return True
        except Exception:  # noqa: BLE001 - any failure is "did not answer"; the run must go on
            pass
    return False


def short(cmd: str, width: int = 120) -> str:
    cmd = re.sub(r"\S*/\.venv/bin/(python3? \S*/)?", "", cmd)
    return cmd if len(cmd) <= width else cmd[: width - 1] + "…"


def index_build(cmd: str) -> bool:
    """Whether a lock holder's command line is the nightly ``wsp ... index build``."""
    return re.search(r"(^|\s)index build(\s|$)", cmd) is not None


def index_silence(pid: str, t: float) -> str | None:
    """The ``index-silent`` message when the build ``pid`` has written nothing to its run log for
    INDEX_SILENT_H hours (None: it has, it keeps no log, or a pause of tools/wsp-yield holds it)."""
    logs = sorted((STATE / "logs" / "index-build").glob(f"*-{pid}.jsonl"))
    if not logs:
        return None
    log = logs[-1]
    try:
        quiet = t - log.stat().st_mtime
    except OSError:
        return None
    if quiet < INDEX_SILENT_H * 3600:
        return None
    try:
        cgroup = (PROC / pid / "cgroup").read_text().strip().splitlines()[-1].split(":", 2)[2]
    except (OSError, IndexError):
        cgroup = ""
    if cgroup and frozen(cgroup):
        return None  # held by the memory guard or the reading pause, not hung
    try:
        with log.open("rb") as fh:
            fh.seek(max(0, fh.seek(0, os.SEEK_END) - 4096))
            tail = fh.read().decode(errors="replace").strip().splitlines()
        last = str(json.loads(tail[-1]).get("msg", ""))[:160] if tail else ""
    except (OSError, ValueError, AttributeError):
        last = ""
    return (
        f"the index build (pid {pid}) has written nothing to {log} for {hours(quiet)} (a normal step is "
        f"quiet under 5 h): hung? Its last line: {last or 'unreadable'}"
    )


def owed_by_yield() -> set[str]:
    """The units tools/wsp-yield stopped for memory and owes a start (``jobs/yield-stopped``)."""
    try:
        text = (JOBS / "jobs" / "yield-stopped").read_text()
    except OSError:
        return set()
    return {line.strip() for line in text.splitlines() if line.strip()}


def save_journal(unit: str, t: float) -> Path | None:
    """The unit's last JOURNAL_LINES journal lines, saved under ``<watch>/failures/`` (the newest
    FAILURES_KEEP files are kept); None when journalctl did not answer in time."""
    exe = shutil.which("journalctl")
    wait = min(SYSTEMCTL_S, remaining())
    if exe is None or wait < 1:
        return None
    try:
        done = subprocess.run(  # noqa: S603 - fixed argv
            [exe, "--user", "-u", unit, "-n", str(JOURNAL_LINES), "--no-pager", "-o", "short-iso"],
            capture_output=True,
            text=True,
            check=False,
            timeout=wait,
        )
    except subprocess.TimeoutExpired:
        return None
    folder = WATCH / "failures"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{datetime.fromtimestamp(t, UTC).strftime('%Y%m%dT%H%M%SZ')}-{unit}.log"
    path.write_text(done.stdout + done.stderr)
    for old in sorted(folder.glob("*.log"))[:-FAILURES_KEEP]:  # named by time: the oldest first
        old.unlink(missing_ok=True)
    return path


def failure_pointers(state: State, unit: str, t: float) -> str:
    """Where to read why ``unit`` failed: its journal, saved the first time the failure is seen (the
    journal itself keeps only about 14 hours here, 2026-11-05 deep dive; deploy/journald/), and the
    run log of a command that keeps one."""
    key = f"unit-failed:{unit}"
    if key not in state.saved:
        path = save_journal(unit, t)
        if path is not None:
            state.saved[key] = str(path)
    saved = state.saved.get(key)
    text = (
        f"; its journal then: {saved}"
        if saved
        else f"; journalctl --user -u {unit} (kept about 14 hours: deploy/journald/)"
    )
    folder = RUN_LOGS.get(unit)
    if folder is not None:
        logs = sorted((STATE / "logs" / folder).glob("*.jsonl"))
        if logs:
            text += f"; its run log: {logs[-1]}"
    return text


def check(state: State, t: float) -> tuple[dict[str, str], list[str], list[str]]:
    """Every open condition (``key -> message``), the one-off notes of this run, and the key prefixes
    of the checks that could not run (systemd too slow): their open conditions are not cleared."""
    cond: dict[str, str] = {}
    notes: list[str] = []
    unknown: list[str] = []
    first = state.held
    held: dict[str, tuple[str, str, float]] = {}
    holders = lock_holders()
    index_pid = holders["index"][0] if "index" in holders else None
    for name, (pid, cmd, age) in holders.items():
        if name in LIFETIME_LOCKS:
            continue
        key = f"{name}:{pid}"
        # Held since the first run that saw it, but never longer than its holder has lived.
        since = max(first.get(key, t), t - age)
        first[key] = since
        held[name] = (pid, cmd, t - since)
        limit = LOCK_LIMIT_H.get(name, LOCK_H)
        if name in ("index", "heavy") and index_build(cmd):
            limit = max(limit, INDEX_LOCK_H)
        if name == "heavy" and pid == index_pid:
            continue  # one job holding both is one condition: lock-held:index names both
        if t - since >= limit * 3600:
            both = name == "index" and holders.get("heavy", ("",))[0] == pid
            what = "index and heavy locks" if both else f"{name} lock"
            cond[f"lock-held:{name}"] = f"{what} held {hours(t - since)} by pid {pid}: {short(cmd)}"
    if index_pid is not None and index_build(holders["index"][1]):
        silent = index_silence(index_pid, t)
        if silent is not None:
            cond["index-silent"] = silent
    for key in list(first):
        name, _, pid = key.partition(":")
        if name not in held or held[name][0] != pid:
            del first[key]

    samples = state.cpu
    waiters = lock_waiters()
    in_queue = queued(t)
    seen: set[str] = set()
    listed = units()
    rows = listed or []
    if listed is None:  # nothing known of any unit: no unit condition ends, no job's samples go
        unknown += ["unit-failed:", "files-high:", "job-idle:", "job-down:"]
    owed_units = owed_by_yield()
    # A halt (tools/wsp-shutdown, for a game or before a restart) stops them all on purpose: one quiet
    # condition, not an alert each. Once any of them runs again, the others are watched again: on
    # 2026-10-30 all but the memory guard were started by hand after a halt.
    halted = (
        HALTED.exists() and listed is not None and not any(u in RUNNING and a == "active" for u, a, _ in rows)
    )
    if halted:
        cond["halted"] = (
            f"the library is halted (tools/wsp-shutdown, {HALTED}): tools/wsp-start starts it again"
        )
    for unit, active, sub in rows:
        if active == "failed":
            cond[f"unit-failed:{unit}"] = f"{unit} failed ({sub})" + failure_pointers(state, unit, t)
            continue
        if unit in RUNNING and active != "active" and unit not in owed_units and not halted:
            down = state.inactive.setdefault(unit, t)
            if t - down >= UNIT_DOWN_MIN * 60:
                cond[f"unit-failed:{unit}"] = (
                    f"{unit} is {active} ({sub}) for {hours(t - down)}: systemctl --user start {unit}"
                    " (after a halt without a reboot, tools/wsp-start starts the whole library)"
                    + failure_pointers(state, unit, t)
                )
        if unit in CORE and active == "active":
            pid = unit_prop(unit, "MainPID")
            if pid is None:
                unknown.append(f"files-high:{unit}")
            files = open_files(pid) if pid and pid != "0" else None
            if files is not None and files[0] > 0.8 * files[1]:
                cond[f"files-high:{unit}"] = f"{unit} holds {files[0]} open files of {files[1]} it may open"
        if not (unit.startswith("whisipedia-job-") and active == "active"):
            continue
        if any(fnmatch.fnmatchcase(unit, pat) for pat in IDLE_OK):
            continue
        cg = unit_prop(unit, "ControlGroup")
        # A restarted unit (a reboot, a resume) counts its CPU from zero: samples of its last run are
        # not a baseline (2026-10-24: six jobs 12 minutes into a fresh boot were "idle for 12.1 h").
        run = unit_prop(unit, "InvocationID") if cg else ""
        if cg is None or run is None:
            seen.add(unit)  # its samples are kept for the next run
            unknown.append(f"job-idle:{unit}")
            continue
        use = cpu_usec(cg) if cg else None
        if use is None:
            continue
        seen.add(unit)
        if state.runs.get(unit) != run:
            samples.pop(unit, None)
            state.runs[unit] = run
        hist = [s for s in samples.get(unit, []) if t - s[0] <= KEEP_SAMPLES_S and s[1] <= use]
        hist.append((t, use))
        samples[unit] = hist
        # Waiting, seen on every run (not only once idle): a lane out of the queue a minute ago, now
        # starting its fetch, still has 3 quiet hours behind it, all of them its turn being waited for.
        pids = cgroup_pids(cg)
        turn = next((in_queue[p] for p in pids if p in in_queue), None)
        lane_wait = any(waiters.get(p, "").startswith("lane:") for p in pids)  # another lane's source
        if (turn is not None and turn[2] < QUEUE_IDLE_H * 3600) or lane_wait or pausing(pids):
            state.waited[unit] = t
        window = [s for s in hist if t - s[0] >= IDLE_H * 3600]
        if not window:
            continue  # not watched long enough yet
        since, base = window[-1]  # the newest sample at least IDLE_H old
        if (use - base) / 1e6 < IDLE_CPU_S:
            why = ""
            if turn is not None and turn[2] < QUEUE_IDLE_H * 3600:
                continue  # waiting its turn, not stalled
            if lane_wait or pausing(pids):
                continue  # waiting for another lane's source, or a lane between rounds (a shell, a sleep)
            # Waiting until less than IDLE_H ago: not quiet that long on its own. A turn waited for over
            # QUEUE_IDLE_H is reported at once, never hidden by the waits before it.
            if turn is None and t - state.waited.get(unit, -1e18) < IDLE_H * 3600:
                continue
            if any(pid in pids and age < IDLE_H * 3600 for pid, _, age in held.values()):
                continue  # its turn just came: it holds a lock it took after the quiet hours of waiting
            if turn is not None:
                why = f"; it is number {turn[1]} in the {turn[0]} lock's queue, waiting {hours(turn[2])}"
            elif frozen(cg):
                why = "; its slice is frozen (tools/wsp-yield: the machine is short of memory)"
            elif held:
                # The lock the job is blocked on, when one of its processes waits in flock (2026-10-19:
                # the job waited for the heavy lock, and the message named the ingest lock); else the
                # likeliest one.
                waits = [waiters[p] for p in pids if p in waiters and waiters[p] in held]
                name = (
                    waits[0]
                    if waits
                    else min(
                        held, key=lambda n: (CAUSE_ORDER.index(n) if n in CAUSE_ORDER else 9, -held[n][2])
                    )
                )
                _, cmd, age = held[name]
                verb = "waits for" if waits else "may be waiting on"
                why = f"; it {verb} the {name} lock, held ({hours(age)}) by {short(cmd, 80)}"
            cond[f"job-idle:{unit}"] = (
                f"{unit} used {(use - base) / 1e6:.0f} s of CPU in {hours(t - since)}{why}"
            )
    for unit in [u for u in samples if u not in seen and listed is not None]:
        del samples[unit]
    downs = {u for u, a, _ in rows if u in RUNNING and a != "active" and u not in owed_units and not halted}
    for unit in [u for u in state.inactive if u not in downs and listed is not None]:
        del state.inactive[unit]
    for unit in [u for u in state.runs if u not in seen and listed is not None]:
        del state.runs[unit]
    for unit in [
        u
        for u in state.waited
        if (u not in seen and listed is not None) or t - state.waited[u] > KEEP_SAMPLES_S
    ]:
        del state.waited[unit]

    owed = JOBS / "jobs" / "yield-stopped"
    try:
        age = t - owed.stat().st_mtime
    except OSError:
        age = 0.0
    names = sorted(owed_units)
    if names and age >= OWED_MIN * 60:
        short_names = ", ".join(n.removeprefix("whisipedia-job-").removesuffix(".service") for n in names)
        cond["jobs-owed"] = (
            f"{len(names)} jobs stopped for memory {hours(age)} ago are not started again "
            f"({short_names[:300]}): "
            "systemctl --user start whisipedia-resume"
        )
    active = {u for u, a, _ in rows if a == "active"}
    try:
        wanted = [
            line.split("#", 1)[0].split()[0]
            for line in (JOBS / "jobs.conf").read_text().splitlines()
            if line.split("#", 1)[0].strip()
        ]
    except OSError:
        wanted = []
    for name in wanted if listed is not None else []:  # unknown: not counted as down either
        if f"whisipedia-job-{name}.service" in active:
            state.down.pop(name, None)
            continue
        since = state.down.setdefault(name, t)
        if t - since >= DOWN_H * 3600:
            cond[f"job-down:{name}"] = (
                f"whisipedia-job-{name} not running for {hours(t - since)}: start it "
                f"(sh {JOBS}/jobs/{name}.cmd), or take it out of {JOBS}/jobs.conf if its work is done"
            )
    for name in [n for n in state.down if n not in wanted]:
        del state.down[name]

    for unit in PRESSURE_UNITS:
        cg = unit_prop(unit, "ControlGroup")
        if cg is None:
            unknown.append(f"mem-stall:{unit}")
        stall = memory_stall(cg) if cg else None
        if stall is not None and stall[0] >= PRESSURE_PCT:
            cond[f"mem-stall:{unit}"] = (
                f"{unit} stalled on memory {stall[0]:.0f}% of the last 5 minutes ({stall[1]}): "
                "everything in it crawls; raise its ceiling or run less in it"
            )

    health = health_ok()
    if health is None:
        unknown.append("api-down")
    elif not health:
        cond["api-down"] = f"{HEALTH_URL} did not answer 200 twice"
    for mount, min_gb in MOUNTS.items():
        if mount != "/" and not os.path.ismount(mount):  # its free space would be the root disk's
            cond[f"nas-missing:{mount}"] = (
                f"{mount} is not mounted: the vault is unreachable; remount the share"
            )
            continue
        try:
            free = shutil.disk_usage(mount).free / 1e9
        except OSError:
            continue
        floor = float(os.environ.get("WSP_STALL_MIN_FREE_GB", min_gb)) if mount == "/" else min_gb
        if free < floor:
            cond[f"disk-low:{mount}"] = f"{mount} has {free:.0f} GB free (under {floor:.0f} GB)"

    notes.extend(scan_logs(state, t))
    if slow:
        cond["systemd-slow"] = (
            f"systemctl did not answer in time ({', '.join(slow[:3])}{'...' if len(slow) > 3 else ''}):"
            " the checks that need it were skipped this run; what they had raised stays open"
        )
    return cond, notes, unknown


def scan_logs(state: State, t: float) -> list[str]:
    """New problem lines since the last run, one note per problem and log a day, a week for a lane's
    own retries (ROUTINE) (the last line, and how many)."""
    offsets, noted = state.offsets, state.noted
    for k in [
        k for k, v in noted.items() if t - v > (NOTE_ROUTINE_S if k.startswith("w:") else NOTE_EVERY_S)
    ]:
        del noted[k]
    notes: list[str] = []
    paths = sorted({p for pattern in LOGS if pattern for p in glob.glob(pattern)})
    for path in paths:
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        start = offsets.get(path)
        offsets[path] = size
        if start is None or size <= start:
            continue  # first sight (no backlog), unchanged, or rotated
        with open(path, "rb") as fh:
            fh.seek(start)
            chunk = fh.read(min(size - start, 8 * 1024 * 1024)).decode(errors="replace")
        hits: dict[str, tuple[int, str]] = {}
        for line in chunk.splitlines():
            m = PROBLEM.search(line)
            if m is None or NOISE.search(line):
                continue
            kind = hashlib.sha1(f"{path}\0{m.group(0)}".encode()).hexdigest()[:16]  # noqa: S324 - a key
            if ROUTINE.fullmatch(m.group(0)):
                kind = "w:" + kind  # a lane's own retry: once a week
            n, _ = hits.get(kind, (0, ""))
            hits[kind] = (n + 1, line.strip())
        for kind, (n, line) in hits.items():
            if kind in noted:
                continue
            noted[kind] = t
            more = f" (x{n})" if n > 1 else ""
            notes.append(f"{Path(path).name}: {line[:300]}{more}")
    for gone in [p for p in offsets if p not in paths]:
        del offsets[gone]
    return notes


def main() -> int:
    WATCH.mkdir(parents=True, exist_ok=True)
    state_path, events = WATCH / "state.json", WATCH / "events.log"
    state = State.load(state_path)
    open_ = state.open
    if sys.argv[1:] == ["--status"]:
        for key, (since, msg) in sorted(open_.items()):
            print(f"{key} (since {stamp(since)}): {msg}")
        return 0
    t = now()
    cond, notes, unknown = check(state, t)
    lines: list[str] = []
    for key, msg in cond.items():
        if key not in open_:
            lines.append(f"{stamp(t)} RAISED {key}: {msg}")
        open_[key] = (open_.get(key, (t, ""))[0], msg)
    # A check that could not run this time says nothing about its conditions: they stay open.
    for key in [k for k in open_ if k not in cond and not k.startswith(tuple(unknown))]:
        since, _ = open_.pop(key)
        lines.append(f"{stamp(t)} CLEARED {key} (open {hours(t - since)})")
    lines += [f"{stamp(t)} NOTE log {n}" for n in notes]
    state.saved = {k: v for k, v in state.saved.items() if k in open_}
    if lines:
        with events.open("a", encoding="utf-8") as fh:
            fh.write("".join(f"{line}\n" for line in lines))
        print("\n".join(lines))
    state.save(state_path)  # before the alerts: a run killed while raising them writes no event twice
    if push(state, t):
        state.save(state_path)
    return 0


def push_severity(key: str, halted: bool = False) -> str | None:
    """The severity a condition is raised with as a ``watch:`` alert, or None (events.log only). While
    the library is halted on purpose its API is down on purpose too."""
    if halted and key == "api-down":
        return None
    for prefix, severity in PUSHED.items():
        if key == prefix or (prefix.endswith(":") and key.startswith(prefix)):
            if prefix == "unit-failed:" and key.removeprefix(prefix) in RUNNING:
                return "critical"
            return severity
    return None


def alert(*args: str) -> bool:
    """``wsp alerts ARGS`` (ALERT_CMD), within the run's budget; whether it succeeded."""
    wait = min(ALERT_S, remaining())
    if wait < 5 or not os.access(ALERT_CMD, os.X_OK):
        return False
    try:
        done = subprocess.run(  # noqa: S603 - fixed argv
            [ALERT_CMD, "alerts", *args],
            cwd=REPO,  # the checkout's config/ unless WSP_CONFIG_DIR names another
            capture_output=True,
            text=True,
            check=False,
            timeout=wait,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return done.returncode == 0


def push(state: State, t: float) -> bool:
    """Raise each open PUSHED condition as ``watch:<key>`` and resolve those gone; one that fails (no
    budget left, the CLI slow) is tried again next run. Whether anything changed."""
    changed = False
    for key, (_, msg) in sorted(state.open.items()):
        severity = push_severity(key, "halted" in state.open)
        if severity is None or key in state.pushed:
            continue
        if alert("raise", "--key", f"watch:{key}", "--severity", severity, "--message", msg):
            state.pushed[key] = t
            changed = True
    for key in [k for k in state.pushed if k not in state.open]:
        if alert("resolve", "--key", f"watch:{key}"):
            del state.pushed[key]
            changed = True
    return changed


if __name__ == "__main__":
    sys.exit(main())
