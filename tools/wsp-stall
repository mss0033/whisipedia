#!/usr/bin/env -S python3 -I
"""Notice when the library's background work stalls (run by whisipedia-stall.timer every 10 minutes).

2026-10-19: the American Stories ingest held the ingest lock for 10.5 hours and a dozen download lanes
sat waiting behind it, and the Chronicling America lane stopped on HTTP 429 at 05:13; both were found
by hand hours later. This looks for such things and writes each one once, when it starts and when it
ends, to ``<state>/watch/events.log`` (and the journal), where a Claude session (a Monitor tailing the
log) or the owner sees it at once:

* ``unit-failed:<unit>``      a whisipedia unit failed; a core service (API, orchestrator) not running
* ``job-idle:<unit>``         a background job (whisipedia-job-*) used under IDLE_CPU_S of CPU in the
                              last WSP_STALL_IDLE_H hours (default 3): stuck, or waiting on something
                              (the message names a long-held lock, or a frozen background slice); not
                              the jobs named by WSP_STALL_IDLE_OK (default whisipedia-job-*-watch.service)
* ``lock-held:<lock>``        a lock (ingest, heavy, index...) held by one process over WSP_STALL_LOCK_H
                              hours (8), counted from the first run that saw it held (the scrub lock
                              is the orchestrator's for its whole life, and is not counted)
* ``jobs-owed``               jobs tools/wsp-yield stopped for memory (``jobs/yield-stopped``) not started
                              again after WSP_STALL_OWED_MIN minutes (30): 2026-10-22, every lane stood
                              still for 10 hours and nothing here said so
* ``job-down:<name>``         a job named in ``jobs.conf`` (the jobs resumed after a reboot) not running
                              for WSP_STALL_DOWN_H hours (1): stopped, crashed, or finished (then take it
                              out of jobs.conf)
* ``api-down``                /v1/health did not answer 200 twice in a row
* ``files-high:<unit>``       a core service holds over 80% of the files it may open (the API ran out at
                              1,024 on 2026-10-20 and answered pages with HTTP 500)
* ``mem-stall:<unit>``         the background slice, the download lanes' slice or the API spent over
                              WSP_STALL_PRESSURE_PCT (50) of the last 5 minutes wholly stalled on memory
                              (memory.pressure "full avg300"): its ceiling is too low for what runs in
                              it, and everything in it crawls (the lanes, 81% on 2026-10-20, unnoticed:
                              each still used enough CPU not to look idle)
* ``disk-low:<mount>``        under WSP_STALL_MIN_FREE_GB free locally (50) or on the NAS (2000)
* ``nas-missing:<mount>``     the NAS share is not mounted (its free space is not checked then)
* ``log``                     a new problem line in a lane log (HTTP 429, Traceback, FAILED, a fetch
                              that failed (exits 7 and 8 are complete), partitions left for later,
                              no space); one note per problem and log a day, never the backlog

Conditions are re-checked every run: ``RAISED`` when one starts, ``CLEARED`` when it is gone.
``--status`` prints what is open now. WSP_STALL_STATE, WSP_STALL_LOGS (colon-separated globs),
WSP_STALL_LOCKS, WSP_STALL_PROC, WSP_STALL_CGROUP_ROOT, WSP_STALL_HEALTH_URL and WSP_STALL_NOW are
for tests.
"""

from __future__ import annotations

import fnmatch
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from dataclasses import asdict, dataclass, field
from datetime import UTC, datetime
from pathlib import Path
from typing import Any, cast

HOME = Path.home()
STATE = Path(os.environ.get("WSP_STALL_STATE", HOME / ".local/share/whisipedia/state"))
WATCH = STATE / "watch"
LOCKS = Path(os.environ.get("WSP_STALL_LOCKS", HOME / ".local/share/whisipedia/locks"))
JOBS = Path(os.environ.get("WSP_STALL_JOBS", HOME / ".local/state/whisipedia"))  # tools/wsp-bg's state
PROC = Path(os.environ.get("WSP_STALL_PROC", "/proc"))
CGROUP_ROOT = os.environ.get("WSP_STALL_CGROUP_ROOT", "/sys/fs/cgroup")
HEALTH_URL = os.environ.get("WSP_STALL_HEALTH_URL", "http://127.0.0.1:8737/v1/health")
LOGS = os.environ.get(
    "WSP_STALL_LOGS",
    ":".join(
        [
            f"{STATE}/*.log",
            f"{STATE}/maps/lane.log",
            f"{HOME}/.local/state/whisipedia/collections/*.log",
        ]
    ),
).split(":")
IDLE_H = float(os.environ.get("WSP_STALL_IDLE_H", "3"))
IDLE_CPU_S = 10.0
# A job waiting its turn in a lock's queue (wsp_cli.locks: a ticket in <lock>.queue/) is not stalled; it
# is reported only after this long in the queue (2026-10-25: NARA, third behind two hour-long ingests,
# was "idle" every 3 hours).
QUEUE_IDLE_H = float(os.environ.get("WSP_STALL_QUEUE_IDLE_H", "12"))
# Jobs idle by design (a watcher that samples every half hour): never "job-idle" (2026-10-23).
IDLE_OK = os.environ.get("WSP_STALL_IDLE_OK", "whisipedia-job-*-watch.service").split(":")
LOCK_H = float(os.environ.get("WSP_STALL_LOCK_H", "8"))
OWED_MIN = float(os.environ.get("WSP_STALL_OWED_MIN", "30"))
DOWN_H = float(os.environ.get("WSP_STALL_DOWN_H", "1"))
MOUNTS = {"/": 50, "/mnt/z": 2000}  # free GB below which the disk is low
CORE = ("whisipedia-api.service", "whisipedia-orchestrator.service")
PRESSURE_UNITS = (
    "whisipedia-background.slice",
    "whisipedia-background-fetch.slice",
    "whisipedia-api.service",
)
PRESSURE_PCT = float(os.environ.get("WSP_STALL_PRESSURE_PCT", "50"))
PROBLEM = re.compile(
    r"HTTP 429|Too Many Requests|Traceback|FAILED|fetch exit [1-69]|left for a later run|No space left"
    r"|Killed|OOM"
)
LIFETIME_LOCKS = {"scrub"}
# Locks held for hours by design: a generation's profile samples a 60 GB archive at a paced rate
# (wsp_cli.integrity.profile_child; 8 h on the Spanish Wikipedia, 2026-10-20).
LOCK_LIMIT_H = {"profile": 24.0}  # held by the orchestrator while it runs (wsp_cli.locks.SCRUB)
CAUSE_ORDER = ("ingest", "heavy", "index")  # the locks a waiting job most likely waits on
NOISE = re.compile(r"another '\w+' is running")  # a lock wait: lock-held reports the holder once
NOTE_EVERY_S = 24 * 3600
KEEP_SAMPLES_S = 26 * 3600


@dataclass
class State:
    """What one run leaves the next (``<state>/watch/state.json``)."""

    open: dict[str, tuple[float, str]] = field(
        default_factory=dict[str, tuple[float, str]]
    )  # key -> since, msg
    held: dict[str, float] = field(default_factory=dict[str, float])  # "lock:pid" -> first seen held
    cpu: dict[str, list[tuple[float, int]]] = field(default_factory=dict[str, list[tuple[float, int]]])
    offsets: dict[str, int] = field(default_factory=dict[str, int])  # log -> bytes read
    noted: dict[str, float] = field(default_factory=dict[str, float])  # problem kind -> when noted
    down: dict[str, float] = field(default_factory=dict[str, float])  # jobs.conf name -> first seen down
    runs: dict[str, str] = field(default_factory=dict[str, str])  # job unit -> InvocationID of its samples

    @classmethod
    def load(cls, path: Path) -> State:
        try:
            raw = cast(dict[str, Any], json.loads(path.read_text()))
            return cls(
                open={k: (float(v[0]), str(v[1])) for k, v in raw.get("open", {}).items()},
                held={k: float(v) for k, v in raw.get("held", {}).items()},
                cpu={k: [(float(a), int(b)) for a, b in v] for k, v in raw.get("cpu", {}).items()},
                offsets={k: int(v) for k, v in raw.get("offsets", {}).items()},
                noted={k: float(v) for k, v in raw.get("noted", {}).items()},
                down={k: float(v) for k, v in raw.get("down", {}).items()},
                runs={k: str(v) for k, v in raw.get("runs", {}).items()},
            )
        except (OSError, ValueError, TypeError, AttributeError, IndexError):
            return cls()

    def save(self, path: Path) -> None:
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(asdict(self)))
        tmp.replace(path)


def now() -> float:
    return float(os.environ.get("WSP_STALL_NOW") or time.time())


def stamp(t: float) -> str:
    return datetime.fromtimestamp(t, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def hours(seconds: float) -> str:
    return f"{seconds / 3600:.1f} h"


def systemctl(*args: str) -> str:
    exe = shutil.which("systemctl")
    if exe is None:
        return ""
    try:
        done = subprocess.run(  # noqa: S603 - fixed argv
            [exe, "--user", *args], capture_output=True, text=True, check=False, timeout=60
        )
    except subprocess.TimeoutExpired:  # systemd slow under memory pressure: unknown, not a crash
        return ""
    return done.stdout


def units() -> list[tuple[str, str, str]]:
    """``(unit, active, sub)`` of every whisipedia unit systemd knows."""
    out = systemctl("list-units", "--all", "--no-legend", "--plain", "whisipedia-*")
    rows: list[tuple[str, str, str]] = []
    for line in out.splitlines():
        f = line.split()
        if len(f) >= 4:
            rows.append((f[0], f[2], f[3]))
    return rows


def unit_prop(unit: str, prop: str) -> str:
    return systemctl("show", unit, "-p", prop, "--value").strip()


def cpu_usec(cgroup: str) -> int | None:
    try:
        for line in Path(f"{CGROUP_ROOT}{cgroup}/cpu.stat").read_text().splitlines():
            k, _, v = line.partition(" ")
            if k == "usage_usec":
                return int(v)
    except (OSError, ValueError):
        return None
    return None


def memory_stall(cgroup: str) -> tuple[float, str] | None:
    """The share (%) of the last 5 minutes the cgroup's tasks were all stalled on memory, and its
    memory use against its ceiling; ``None`` when unknown."""
    base = Path(f"{CGROUP_ROOT}{cgroup}")
    try:
        full = next(ln for ln in (base / "memory.pressure").read_text().splitlines() if ln.startswith("full"))
        pct = float(dict(f.split("=", 1) for f in full.split()[1:])["avg300"])
    except (OSError, StopIteration, KeyError, ValueError):
        return None
    try:
        use = f"{int((base / 'memory.current').read_text()) / 2**20:,.0f} MB"
        high = (base / "memory.high").read_text().strip()
        use += f" of memory.high {int(high) / 2**20:,.0f} MB" if high.isdigit() else ""
    except (OSError, ValueError):
        use = "use unknown"
    return pct, use


def frozen(cgroup: str) -> bool:
    """Whether the job's cgroup or a slice above it is frozen (tools/wsp-yield)."""
    parts = cgroup.strip("/").split("/")
    for i in range(len(parts), 0, -1):
        try:
            if Path(f"{CGROUP_ROOT}/{'/'.join(parts[:i])}/cgroup.freeze").read_text().strip() == "1":
                return True
        except OSError:
            continue
    return False


def process(pid: str) -> tuple[str, float | None]:
    """A process's command line and its age in seconds (None if it is gone)."""
    try:
        cmd = (PROC / pid / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
        start_ticks = int((PROC / pid / "stat").read_text().rsplit(")", 1)[1].split()[19])
        uptime = float((PROC / "uptime").read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return "", None
    return cmd, uptime - start_ticks / os.sysconf("SC_CLK_TCK")


def lock_waiters() -> dict[str, str]:
    """``pid -> lock name`` of every process blocked waiting for a lock file in LOCKS (``->`` lines)."""
    by_inode = _lock_inodes()
    out: dict[str, str] = {}
    try:
        lines = (PROC / "locks").read_text().splitlines()
    except OSError:
        return out
    for line in lines:
        f = line.split()
        if len(f) < 7 or f[1] != "->" or f[2] != "FLOCK":
            continue
        try:
            name = by_inode.get(_lock_file_key(f[6]))
        except (IndexError, ValueError):
            continue
        if name is not None:
            out[f[5]] = name
    return out


def queued(now: float) -> dict[str, tuple[str, int, float]]:
    """``pid -> (lock name, place in its queue from 1, seconds waited)`` of every waiter holding a ticket
    (``<lock>.queue/<time_ns>-<pid>``) whose process is alive."""
    out: dict[str, tuple[str, int, float]] = {}
    for q in sorted(LOCKS.glob("*.queue")):
        try:
            names = sorted(n.name for n in q.iterdir() if not n.name.startswith("."))
        except OSError:
            continue
        place = 0
        for name in names:
            stamp, _, pid = name.partition("-")
            if not (stamp.isdigit() and pid.isdigit() and (PROC / pid).is_dir()):
                continue
            place += 1
            try:  # its age is its mtime: the name is a steady-clock stamp (order only)
                waited = max(0.0, now - (q / name).stat().st_mtime)
            except OSError:
                continue
            out[pid] = (q.name.removesuffix(".queue"), place, waited)
    return out


def _lock_inodes() -> dict[str, str]:
    """``"MAJ:MIN:INODE" -> lock name`` as /proc/locks names files: the device too, since a file on the
    NAS can have the same inode number as a local lock file (2026-10-26 review)."""
    by_inode: dict[str, str] = {}
    for p in LOCKS.glob("*.lock"):
        try:
            st = p.stat()
        except OSError:
            continue
        by_inode[f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"] = p.stem
    return by_inode


def _lock_file_key(field: str) -> str:
    """/proc/locks' ``MAJ:MIN:INODE`` (major and minor in hex), normalised to two hex digits each."""
    major, minor, inode = field.split(":")
    return f"{int(major, 16):02x}:{int(minor, 16):02x}:{int(inode)}"


def cgroup_pids(cgroup: str) -> set[str]:
    try:
        return set(Path(f"{CGROUP_ROOT}{cgroup}/cgroup.procs").read_text().split())
    except OSError:
        return set()


# A job between rounds: every process in it is a shell or its `sleep` (tools/lanes/lane-run.sh's
# pause, a job script's `sleep 7200` between passes). Idle by design, not stalled: 27 "job-idle" alerts
# in 10 days, most of them lanes waiting an hour for their next round (2026-10-29 spot check).
PAUSE_COMMS = frozenset({"sh", "bash", "dash", "sleep", "timeout"})


def pausing(pids: set[str]) -> bool:
    comms: set[str] = set()
    for pid in pids:
        try:
            # A script run by its shebang is named after the script (`lane-run.sh`): its executable,
            # the shell, says what it is (2026-10-30: the first such alert after the rule).
            try:
                name = os.path.basename(os.readlink(PROC / pid / "exe"))
            except OSError:
                name = (PROC / pid / "comm").read_text().strip()
        except OSError:
            return False  # gone, or unreadable: not known to be a pause
        comms.add("sh" if name.endswith(".sh") else name)
    return bool(comms) and comms <= PAUSE_COMMS and "sleep" in comms


def lock_holders() -> dict[str, tuple[str, str, float]]:
    """``lock name -> (pid, command, age seconds)`` of every lock file in LOCKS that is held."""
    by_inode = _lock_inodes()
    held: dict[str, tuple[str, str, float]] = {}
    try:
        lines = (PROC / "locks").read_text().splitlines()
    except OSError:
        return held
    for line in lines:
        f = line.split()
        if len(f) < 6 or f[1] != "FLOCK" or f[3] == "->":
            continue
        try:
            name = by_inode.get(_lock_file_key(f[5]))
        except ValueError:
            continue
        if name is None:
            continue
        cmd, age = process(f[4])
        if age is not None and (name not in held or age > held[name][2]):
            held[name] = (f[4], cmd, age)
    return held


def open_files(pid: str) -> tuple[int, int] | None:
    """``(open, soft limit)`` of a process's file descriptors."""
    try:
        count = len(list((PROC / pid / "fd").iterdir()))
        for line in (PROC / pid / "limits").read_text().splitlines():
            if line.startswith("Max open files"):
                return count, int(line.split()[3])
    except (OSError, ValueError, IndexError):
        return None
    return None


def health_ok() -> bool:
    for _ in range(2):
        try:
            with urllib.request.urlopen(HEALTH_URL, timeout=30) as r:  # noqa: S310 - local API
                if r.status == 200:
                    return True
        except Exception:  # noqa: BLE001 - any failure is "did not answer"; the run must go on
            pass
    return False


def short(cmd: str, width: int = 120) -> str:
    cmd = re.sub(r"\S*/\.venv/bin/(python3? \S*/)?", "", cmd)
    return cmd if len(cmd) <= width else cmd[: width - 1] + "…"


def check(state: State, t: float) -> tuple[dict[str, str], list[str]]:
    """Every open condition (``key -> message``) and the one-off notes of this run."""
    cond: dict[str, str] = {}
    notes: list[str] = []
    first = state.held
    held: dict[str, tuple[str, str, float]] = {}
    for name, (pid, cmd, age) in lock_holders().items():
        if name in LIFETIME_LOCKS:
            continue
        key = f"{name}:{pid}"
        # Held since the first run that saw it, but never longer than its holder has lived.
        since = max(first.get(key, t), t - age)
        first[key] = since
        held[name] = (pid, cmd, t - since)
        if t - since >= LOCK_LIMIT_H.get(name, LOCK_H) * 3600:
            cond[f"lock-held:{name}"] = f"{name} lock held {hours(t - since)} by pid {pid}: {short(cmd)}"
    for key in list(first):
        name, _, pid = key.partition(":")
        if name not in held or held[name][0] != pid:
            del first[key]

    samples = state.cpu
    waiters = lock_waiters()
    in_queue = queued(t)
    seen: set[str] = set()
    rows = units()
    for unit, active, sub in rows:
        if active == "failed":
            cond[f"unit-failed:{unit}"] = f"{unit} failed ({sub}); journalctl --user -u {unit}"
            continue
        if unit in CORE and active != "active":
            cond[f"unit-failed:{unit}"] = f"{unit} is {active} ({sub})"
        if unit in CORE and active == "active":
            pid = unit_prop(unit, "MainPID")
            files = open_files(pid) if pid and pid != "0" else None
            if files is not None and files[0] > 0.8 * files[1]:
                cond[f"files-high:{unit}"] = f"{unit} holds {files[0]} open files of {files[1]} it may open"
        if not (unit.startswith("whisipedia-job-") and active == "active"):
            continue
        if any(fnmatch.fnmatchcase(unit, pat) for pat in IDLE_OK):
            continue
        cg = unit_prop(unit, "ControlGroup")
        use = cpu_usec(cg) if cg else None
        if use is None:
            continue
        seen.add(unit)
        # A restarted unit (a reboot, a resume) counts its CPU from zero: samples of its last run are
        # not a baseline (2026-10-24: six jobs 12 minutes into a fresh boot were "idle for 12.1 h").
        run = unit_prop(unit, "InvocationID")
        if state.runs.get(unit) != run:
            samples.pop(unit, None)
            state.runs[unit] = run
        hist = [s for s in samples.get(unit, []) if t - s[0] <= KEEP_SAMPLES_S and s[1] <= use]
        hist.append((t, use))
        samples[unit] = hist
        window = [s for s in hist if t - s[0] >= IDLE_H * 3600]
        if not window:
            continue  # not watched long enough yet
        since, base = window[-1]  # the newest sample at least IDLE_H old
        if (use - base) / 1e6 < IDLE_CPU_S:
            why = ""
            pids = cgroup_pids(cg)
            turn = next((in_queue[p] for p in pids if p in in_queue), None)
            if turn is not None and turn[2] < QUEUE_IDLE_H * 3600:
                continue  # waiting its turn, not stalled
            if pausing(pids):
                continue  # a lane between rounds: a shell and its sleep
            if any(pid in pids and age < IDLE_H * 3600 for pid, _, age in held.values()):
                continue  # its turn just came: it holds a lock it took after the quiet hours of waiting
            if turn is not None:
                why = f"; it is number {turn[1]} in the {turn[0]} lock's queue, waiting {hours(turn[2])}"
            elif frozen(cg):
                why = "; its slice is frozen (tools/wsp-yield: the machine is short of memory)"
            elif held:
                # The lock the job is blocked on, when one of its processes waits in flock (2026-10-19:
                # the job waited for the heavy lock, and the message named the ingest lock); else the
                # likeliest one.
                waits = [waiters[p] for p in cgroup_pids(cg) if p in waiters and waiters[p] in held]
                name = (
                    waits[0]
                    if waits
                    else min(
                        held, key=lambda n: (CAUSE_ORDER.index(n) if n in CAUSE_ORDER else 9, -held[n][2])
                    )
                )
                _, cmd, age = held[name]
                verb = "waits for" if waits else "may be waiting on"
                why = f"; it {verb} the {name} lock, held ({hours(age)}) by {short(cmd, 80)}"
            cond[f"job-idle:{unit}"] = (
                f"{unit} used {(use - base) / 1e6:.0f} s of CPU in {hours(t - since)}{why}"
            )
    for unit in [u for u in samples if u not in seen]:
        del samples[unit]
    for unit in [u for u in state.runs if u not in seen]:
        del state.runs[unit]

    owed = JOBS / "jobs" / "yield-stopped"
    try:
        age = t - owed.stat().st_mtime
        names = sorted({line.strip() for line in owed.read_text().splitlines() if line.strip()})
    except OSError:
        age, names = 0.0, []
    if names and age >= OWED_MIN * 60:
        short_names = ", ".join(n.removeprefix("whisipedia-job-").removesuffix(".service") for n in names)
        cond["jobs-owed"] = (
            f"{len(names)} jobs stopped for memory {hours(age)} ago are not started again "
            f"({short_names[:300]}): "
            "systemctl --user start whisipedia-resume"
        )
    active = {u for u, a, _ in rows if a == "active"}
    try:
        wanted = [
            line.split("#", 1)[0].split()[0]
            for line in (JOBS / "jobs.conf").read_text().splitlines()
            if line.split("#", 1)[0].strip()
        ]
    except OSError:
        wanted = []
    for name in wanted:
        if f"whisipedia-job-{name}.service" in active:
            state.down.pop(name, None)
            continue
        since = state.down.setdefault(name, t)
        if t - since >= DOWN_H * 3600:
            cond[f"job-down:{name}"] = (
                f"whisipedia-job-{name} not running for {hours(t - since)}: start it "
                f"(sh {JOBS}/jobs/{name}.cmd), or take it out of {JOBS}/jobs.conf if its work is done"
            )
    for name in [n for n in state.down if n not in wanted]:
        del state.down[name]

    for unit in PRESSURE_UNITS:
        cg = unit_prop(unit, "ControlGroup")
        stall = memory_stall(cg) if cg else None
        if stall is not None and stall[0] >= PRESSURE_PCT:
            cond[f"mem-stall:{unit}"] = (
                f"{unit} stalled on memory {stall[0]:.0f}% of the last 5 minutes ({stall[1]}): "
                "everything in it crawls; raise its ceiling or run less in it"
            )

    if not health_ok():
        cond["api-down"] = f"{HEALTH_URL} did not answer 200 twice"
    for mount, min_gb in MOUNTS.items():
        if mount != "/" and not os.path.ismount(mount):  # its free space would be the root disk's
            cond[f"nas-missing:{mount}"] = f"{mount} is not mounted: the vault is unreachable; remount the share"
            continue
        try:
            free = shutil.disk_usage(mount).free / 1e9
        except OSError:
            continue
        floor = float(os.environ.get("WSP_STALL_MIN_FREE_GB", min_gb)) if mount == "/" else min_gb
        if free < floor:
            cond[f"disk-low:{mount}"] = f"{mount} has {free:.0f} GB free (under {floor:.0f} GB)"

    notes.extend(scan_logs(state, t))
    return cond, notes


def scan_logs(state: State, t: float) -> list[str]:
    """New problem lines since the last run, one note per problem and log a day (the last line, and
    how many)."""
    offsets, noted = state.offsets, state.noted
    for k in [k for k, v in noted.items() if t - v > NOTE_EVERY_S]:
        del noted[k]
    notes: list[str] = []
    paths = sorted({p for pattern in LOGS if pattern for p in glob.glob(pattern)})
    for path in paths:
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        start = offsets.get(path)
        offsets[path] = size
        if start is None or size <= start:
            continue  # first sight (no backlog), unchanged, or rotated
        with open(path, "rb") as fh:
            fh.seek(start)
            chunk = fh.read(min(size - start, 8 * 1024 * 1024)).decode(errors="replace")
        hits: dict[str, tuple[int, str]] = {}
        for line in chunk.splitlines():
            m = PROBLEM.search(line)
            if m is None or NOISE.search(line):
                continue
            kind = hashlib.sha1(f"{path}\0{m.group(0)}".encode()).hexdigest()[:16]  # noqa: S324 - a key
            n, _ = hits.get(kind, (0, ""))
            hits[kind] = (n + 1, line.strip())
        for kind, (n, line) in hits.items():
            if kind in noted:
                continue
            noted[kind] = t
            more = f" (x{n})" if n > 1 else ""
            notes.append(f"{Path(path).name}: {line[:300]}{more}")
    for gone in [p for p in offsets if p not in paths]:
        del offsets[gone]
    return notes


def main() -> int:
    WATCH.mkdir(parents=True, exist_ok=True)
    state_path, events = WATCH / "state.json", WATCH / "events.log"
    state = State.load(state_path)
    open_ = state.open
    if sys.argv[1:] == ["--status"]:
        for key, (since, msg) in sorted(open_.items()):
            print(f"{key} (since {stamp(since)}): {msg}")
        return 0
    t = now()
    cond, notes = check(state, t)
    lines: list[str] = []
    for key, msg in cond.items():
        if key not in open_:
            lines.append(f"{stamp(t)} RAISED {key}: {msg}")
        open_[key] = (open_.get(key, (t, ""))[0], msg)
    for key in [k for k in open_ if k not in cond]:
        since, _ = open_.pop(key)
        lines.append(f"{stamp(t)} CLEARED {key} (open {hours(t - since)})")
    lines += [f"{stamp(t)} NOTE log {n}" for n in notes]
    if lines:
        with events.open("a", encoding="utf-8") as fh:
            fh.write("".join(f"{line}\n" for line in lines))
        print("\n".join(lines))
    state.save(state_path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
