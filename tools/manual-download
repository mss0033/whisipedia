#!/usr/bin/env -S python3 -I
"""The owner's own download of one large file from a host that drops connections (run by hand).

2026-11-02: the Crystallography Open Database's full archive (26.6 GB, one file) stalled in the owner's
browser at 862 MB after four hours; the host resets connections mid-transfer and the browser does not
resume well. The host's robots.txt disallows crawlers, so the library never fetches it; this is the
owner's download, started by the owner, like the browser's:

    tools/manual-download URL FOLDER [--name NAME] [--adopt PARTIAL]

It downloads URL into FOLDER/NAME (NAME defaults to the URL's file name) over one connection with the
library's generic User-Agent, and after any reset or timeout continues from the bytes it has (an HTTP
Range request), waiting longer each time (up to WAIT_MAX_S). ``If-Range`` with the file's validator
(ETag, else Last-Modified) makes the host send the whole file again rather than mix two versions.
While it runs the file is ``NAME.part`` (the manual import leaves such files alone); when the size
matches the host's Content-Length it is renamed to NAME and the next run of the manual job takes it.
The validator is kept beside it as the hidden ``.NAME.validator``: a ``.part`` from a run before the
host's file changed is begun again, never continued. ``--adopt`` continues from a partial file another
program left (a browser's ``.part``): it is renamed to ``NAME.part`` first (stop that program's download
first); its version cannot be known, so the size and the archive's own check at import are its guard.
Stop it with Ctrl+C; run it again to go on where it stopped.
"""

from __future__ import annotations

import argparse
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import unquote, urlsplit

USER_AGENT = "Whisipedia/0.1 (personal offline archive)"
CHUNK = 1 << 20
SYNC_EVERY = 256 << 20  # bytes written between fsyncs: a crash loses at most this much
TIMEOUT_S = float(os.environ.get("WSP_DL_TIMEOUT", "60"))  # a read that waits longer is a dropped connection
WAIT_MIN_S = float(os.environ.get("WSP_DL_WAIT_MIN", "5"))
WAIT_MAX_S = float(os.environ.get("WSP_DL_WAIT_MAX", "600"))
TRIES = int(os.environ.get("WSP_DL_TRIES", "0"))  # 0: never give up (Ctrl+C stops it)


def say(text: str) -> None:
    print(f"{time.strftime('%H:%M:%S')} {text}", flush=True)


def gb(n: int) -> str:
    return f"{n / 1e9:.2f} GB"


def head(url: str) -> tuple[int, str]:
    """The file's size and validator (ETag, else Last-Modified)."""
    req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": USER_AGENT})  # noqa: S310 - http(s) only (main)
    with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:  # noqa: S310
        size = int(resp.headers.get("Content-Length") or 0)
        validator = resp.headers.get("ETag") or resp.headers.get("Last-Modified") or ""
    if size <= 0:
        raise OSError("the host gives no Content-Length; this tool needs one to know when it is done")
    return size, validator


def fetch_from(url: str, part: Path, size: int, validator: str) -> int:
    """Append to ``part`` from its current length; returns the length reached. Raises on a drop."""
    have = part.stat().st_size if part.exists() else 0
    if have > size:
        raise OSError(f"{part.name} is larger than the file ({have} > {size}); delete it and start again")
    if have == size:
        return have
    headers = {"User-Agent": USER_AGENT, "Range": f"bytes={have}-"}
    if validator:
        headers["If-Range"] = validator
    req = urllib.request.Request(url, headers=headers)  # noqa: S310 - http(s) only (main)
    with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:  # noqa: S310
        if resp.status == 200 and have:  # the file changed upstream (or no ranges): begin again
            say(f"the host sent the whole file (changed since {have:,} bytes?): starting over")
            have = 0
            mode = "wb"
        elif resp.status == 206:
            start = int((resp.headers.get("Content-Range") or "bytes 0-").split()[1].split("-")[0])
            if start != have:
                raise OSError(f"asked for bytes from {have}, the host sent from {start}")
            mode = "ab"
        else:
            mode = "wb" if not have else "ab"
        written_since_sync = 0
        with part.open(mode) as out:
            while chunk := resp.read(CHUNK):
                out.write(chunk)
                have += len(chunk)
                written_since_sync += len(chunk)
                if written_since_sync >= SYNC_EVERY:
                    out.flush()
                    os.fsync(out.fileno())
                    written_since_sync = 0
                    say(f"{gb(have)} of {gb(size)} ({100 * have / size:.1f}%)")
            out.flush()
            os.fsync(out.fileno())
    return have


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("url")
    ap.add_argument("folder", type=Path)
    ap.add_argument("--name", help="file name to save as (default: the URL's)")
    ap.add_argument("--adopt", type=Path, help="a partial download to continue from (renamed into place)")
    args = ap.parse_args(argv)
    if urlsplit(args.url).scheme not in ("http", "https"):
        ap.error("only http and https links")
    name = args.name or unquote(urlsplit(args.url).path.rstrip("/").rpartition("/")[2])
    if not name:
        ap.error("the URL names no file; give --name")
    final, part = args.folder / name, args.folder / f"{name}.part"
    kept = args.folder / f".{name}.validator"
    if final.exists() and final.stat().st_size > 0:
        say(f"{final} is already there; nothing to do")
        return 0
    if args.adopt is not None:
        if part.exists():
            ap.error(f"{part} exists already; --adopt would replace it")
        args.adopt.rename(part)
        say(f"continuing from {args.adopt.name} ({gb(part.stat().st_size)})")
    wait, tries = WAIT_MIN_S, 0
    size = validator = None
    while True:
        before = part.stat().st_size if part.exists() else 0
        try:
            if size is None:
                size, validator = head(args.url)
                say(f"{name}: {gb(size)} at {args.url}")
                old = kept.read_text().strip() if kept.exists() else None
                if part.exists() and validator and old is not None and old != validator:
                    say(f"the host's file changed since {part.name} was begun: starting over")
                    part.unlink()
                if validator:
                    kept.write_text(validator + "\n")
            have = fetch_from(args.url, part, size, validator or "")
            if have == size:
                break
            raise OSError(f"the connection ended at {have:,} of {size:,} bytes")
        except KeyboardInterrupt:
            kept_bytes = part.stat().st_size if part.exists() else 0
            say(f"stopped; {part.name} kept ({gb(kept_bytes)}): run again to go on")
            return 130
        except (OSError, urllib.error.URLError, TimeoutError) as exc:
            tries += 1
            if TRIES and tries >= TRIES:
                say(f"giving up after {tries} tries: {exc}")
                return 1
            got = part.stat().st_size if part.exists() else 0
            say(f"dropped ({exc}); {gb(got)} kept, trying again in {wait:.0f} s")
            time.sleep(wait)
            # A drop after progress is the host's habit: go on soon. No progress: wait longer each time.
            wait = WAIT_MIN_S if got > before else min(WAIT_MAX_S, wait * 2)
    if final.exists():  # a browser's empty placeholder under the final name
        final.unlink()
    part.rename(final)
    kept.unlink(missing_ok=True)
    say(f"done: {final} ({gb(size)}); the manual job takes it within the hour")
    return 0


if __name__ == "__main__":
    sys.exit(main())
