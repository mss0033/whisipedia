{
  "name": "@whisipedia/navigator",
  "version": "0.1.0",
  "private": true,
  "description": "Whisipedia Navigator: a retro web browser for the offline library",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-bundle.mjs",
    "smoke": "node scripts/smoke-dist.mjs",
    "check": "npm run check:api && npm run typecheck && npm run lint && npm run test && npm run build && npm run budget && npm run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
