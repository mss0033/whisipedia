# Whisipedia API + Navigator (`wsp serve`) as a systemd USER service, on loopback only.
#
# Template: `wsp service install` renders @REPO@ and @CONFIG_DIR@ (docs/runbooks/install-services.md).
# Serves navigator/dist (build it with `cd navigator && npm run build`) at http://127.0.0.1:8737/.
# Offline guarantee (PLAN §10.5): the API makes no outbound connections; systemd additionally
# restricts it to loopback where the user manager supports IP filtering.

[Unit]
Description=Whisipedia API and Navigator (loopback, offline)
Documentation=file://@REPO@/docs/components/api.md

[Service]
Type=simple
# The API keeps every source's index shards open: 936 files on 2026-10-20 (American Stories, the topo
# map partitions), and the default soft limit of 1,024 answered Wiktionary pages with "Too many open
# files" (HTTP 500). The hard limit is far higher.
LimitNOFILE=65536
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/whisipedia/whisipedia.env
Environment=PYTHONUNBUFFERED=1
# Fewer glibc malloc arenas: a long-lived threaded server otherwise keeps freed memory in per-thread
# arenas and its resident size creeps up over hours.
Environment=MALLOC_ARENA_MAX=2
Environment=WSP_CONFIG_DIR=@CONFIG_DIR@
ExecStart=@REPO@/.venv/bin/wsp --config-dir @CONFIG_DIR@ serve --host 127.0.0.1 --port 8737
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# Loopback only: ignored with a warning where the user manager cannot do BPF IP filtering.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Interactive: outside the background slice, with its own ceiling (caches are bounded; a leak
# must restart the API, not stall the desktop). MemoryHigh only throttles, so whisipedia-api-health.timer
# restarts an API that stops answering. Steady state ~2.5-3 GB, most of it the CUDA runtime and models.
# File pages of the memory-mapped search index are charged here too: a ceiling near the anonymous
# footprint (~2.5 GB) evicted the index between queries and every search faulted it back (cold
# searches 12-20 s against 7-12 s with room for the cache; 2026-10-13). Only anonymous memory grows.
MemoryHigh=10G
MemoryMax=12G
MemorySwapMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0027

[Install]
WantedBy=default.target
