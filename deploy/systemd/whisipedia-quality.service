# The weekly search-quality check (`wsp quality run --alerts`): the gold queries through the running
# library's API, saved under <state>/quality/; a drop of nDCG@10, or a median latency twice the best
# quiet run's, opens a warning. It first waits up to 6 h for a running index build to finish
# (wsp_cli.quality). Started by whisipedia-quality.timer. Its searches are marked as a background probe.
#
# Template: `wsp service install` renders @REPO@ and @CONFIG_DIR@ (docs/runbooks/install-services.md).

[Unit]
Description=Whisipedia weekly search-quality check
After=whisipedia-api.service

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/whisipedia/whisipedia.env
ExecStart=@REPO@/.venv/bin/wsp --config-dir @CONFIG_DIR@ quality run --alerts
# A run takes minutes; time frozen by tools/wsp-yield while the owner reads counts too (its searches
# would compete with the owner's), so the ceiling is for a hung run, not a slow one.
TimeoutStartSec=12h
Nice=19
CPUWeight=20
Slice=whisipedia-background.slice
MemoryHigh=1G
MemoryMax=2G
