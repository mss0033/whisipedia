# Whisipedia orchestrator (Curator + Acquirer + Warden scheduling) as a systemd USER service.
# The only Whisipedia process with network access (PLAN §3, §10.5).
#
# Template: `wsp service install` renders @REPO@ and @CONFIG_DIR@ from your checkout into
# ~/.config/systemd/user/ and enables it (see docs/runbooks/install-services.md). Machine-specific
# values (vault root on the NAS, LOCAL state paths) belong in config/local.toml, never here. Optional
# environment overrides (WSP__SECTION__KEY=value) go in ~/.config/whisipedia/whisipedia.env.

[Unit]
Description=Whisipedia orchestrator (discovery, downloads, scrub, parity, curator bots)
Documentation=file://@REPO@/docs/components/orchestrator.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/whisipedia/whisipedia.env
Environment=PYTHONUNBUFFERED=1
Environment=WSP_CONFIG_DIR=@CONFIG_DIR@
# The NAS may not be mounted yet after a Windows/WSL start: fail fast and retry.
ExecStartPre=@REPO@/.venv/bin/wsp --config-dir @CONFIG_DIR@ doctor --quiet --require vault
ExecStart=@REPO@/.venv/bin/wsp-orchestrator --config-dir @CONFIG_DIR@
# SIGTERM -> prompt shutdown: stop claiming jobs, cancel downloads/scrub/parity, exit within
# orchestrator.shutdown_grace_seconds (10 s); unfinished work resumes on the next start.
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure
RestartSec=60
# Logs are JSON lines on stderr -> journald (`journalctl --user -u whisipedia-orchestrator -o cat`).
StandardOutput=journal
StandardError=journal
# Be a good neighbour to the browser and the NAS (scrub and parity are IO-heavy).
Nice=19
CPUWeight=20
# Shared budget with every other background job (whisipedia-background.slice); the orchestrator's
# own ceiling leaves room in the slice for an index build. OOMScoreAdjust: if the kernel must kill,
# it kills background work before anything the owner is using.
Slice=whisipedia-background.slice
MemoryHigh=6G
MemoryMax=8G
OOMScoreAdjust=500
Environment=WSP_MAX_WORKERS=4
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0027

[Install]
WantedBy=default.target
