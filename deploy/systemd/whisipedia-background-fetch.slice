# Whisipedia download lanes (`tools/wsp-bg --fetch`, tools/lanes/lane-run.sh): their share of
# whisipedia-background.slice (systemd nests it there by its name). However many lanes run, together
# they never take more than this, so a heavy job and the orchestrator keep theirs (audit 2026-10-12
# H1; the arithmetic is in whisipedia-background.slice). Lanes wait on the network, not on memory, but
# throttling them is not free: at 1G, eleven lanes (30-190 MB each) sat over the line and every lane was
# stalled 81% of the time (memory.pressure "full", 2026-10-20).
#
# Template: `wsp service install` renders this file (docs/runbooks/install-services.md).

[Unit]
Description=Whisipedia download lanes (share of the background budget)

[Slice]
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=512M
CPUWeight=20
IOWeight=10
# The download lanes' share of the background tasks (see whisipedia-background.slice, 2026-10-20).
TasksMax=1024
