# Whisipedia index refresh (`wsp index build`): refines and indexes sealed generations that arrived
# outside the orchestrator (bulk `wsp ingest`), and rebuilds the portal/directory catalog. Idempotent:
# already refined generations are skipped. Started by whisipedia-index.timer; no network needed.
#
# Template: `wsp service install` renders @REPO@ and @CONFIG_DIR@ (docs/runbooks/install-services.md).

[Unit]
Description=Whisipedia index refresh (Refinery, Tantivy, catalog)
Documentation=file://@REPO@/docs/components/index.md

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/whisipedia/whisipedia.env
Environment=PYTHONUNBUFFERED=1
Environment=WSP_CONFIG_DIR=@CONFIG_DIR@
ExecStartPre=@REPO@/.venv/bin/wsp --config-dir @CONFIG_DIR@ doctor --quiet --require vault
ExecStart=@REPO@/.venv/bin/wsp --config-dir @CONFIG_DIR@ index build
# Exit 3: the machine-wide "heavy" or "index" lock is held (an orchestrator refine/index unit, a
# manual build). Not a failure: the timer (Persistent=true) tries again the next night.
SuccessExitStatus=3
KillMode=mixed
TimeoutStopSec=120
Nice=19
CPUWeight=20
Slice=whisipedia-background.slice
MemoryHigh=7G
MemoryMax=9G
OOMScoreAdjust=500
Environment=WSP_MAX_WORKERS=4
# best-effort/7, not idle: the build holds the index lock for hours (priority inversion).
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0027
